{
  "description": "Windows: publish semantic lifecycle states to the local CodexPetHub Named Pipe. Other operating systems: no-op.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'scripts/Invoke-CodexPetHook.ps1')\"",
            "timeout": 3,
            "command": "true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'scripts/Invoke-CodexPetHook.ps1')\"",
            "timeout": 3,
            "command": "true"
          }
